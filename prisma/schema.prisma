// Prisma Schema for AI Company Case Library
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  learner
  editor
  admin
}

enum TagType {
  industry
  technique
  business_model
  geography
  stage
}

enum QuizType {
  module
  theme
  scenario
  final
}

enum QuestionType {
  mcq
  scenario
}

enum InteractionType {
  poll
  challenge
  tradeoff
  peer_insight
}

model User {
  id                 String                  @id @default(uuid())
  name               String
  email              String                  @unique
  passwordHash       String
  role               UserRole                @default(learner)
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  resetTokens        PasswordResetToken[]
  quizAttempts       UserQuizAttempt[]
  moduleInteractions UserModuleInteraction[]
  companyProgress    UserCompanyProgress[]
  badges             UserBadge[]
  streak             UserStreak?
  certificates       Certificate[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Company {
  id                       String                @id @default(uuid())
  slug                     String                @unique
  name                     String
  logoUrl                  String?
  logoPermission           Boolean               @default(false)
  founders                 String
  foundingYear             Int
  hqCity                   String
  hqCountry                String
  sector                   String
  valueProposition         String
  fundingStage             String
  notableInvestors         String
  problemDescription       String                @db.Text
  aiSolutionDescription     String                @db.Text
  businessModelDescription String                @db.Text
  tractionMetrics          Json                  // { arr: string, users: string, queries: string, growth: string, breakdown: any[] }
  keyInsights              String[]
  funFact                  String?               @db.Text
  readingTimeMin           Int                   @default(7)
  isFeatured               Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  companyTags              CompanyTag[]
  themeCompanies           ThemeCompany[]
  quizzes                  Quiz[]
  moduleInteractions       ModuleInteraction[]
  userProgress             UserCompanyProgress[]

  @@index([slug])
}

model Tag {
  id          String       @id @default(uuid())
  type        TagType
  value       String
  companyTags CompanyTag[]

  @@unique([type, value])
  @@index([type, value])
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model Theme {
  id             String         @id @default(uuid())
  slug           String         @unique
  name           String
  description    String         @db.Text
  createdAt      DateTime       @default(now())
  themeCompanies ThemeCompany[]
  quizzes        Quiz[]
}

model ThemeCompany {
  themeId   String
  companyId String
  sortOrder Int     @default(0)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([themeId, companyId])
}

model Quiz {
  id                  String            @id @default(uuid())
  type                QuizType          @default(module)
  companyId           String?
  themeId             String?
  title               String
  description         String            @db.Text
  passingScorePercent Int               @default(70)
  createdAt           DateTime          @default(now())
  company             Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  theme               Theme?            @relation(fields: [themeId], references: [id], onDelete: Cascade)
  questions           Question[]
  userAttempts        UserQuizAttempt[]
}

model Question {
  id              String       @id @default(uuid())
  quizId          String
  quiz            Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type            QuestionType @default(mcq)
  text            String       @db.Text
  options         Json         // [{ id: "opt_1", text: "Option A" }, ...]
  correctOptionId String
  explanation     String       @db.Text
  sortOrder       Int          @default(0)
}

model UserQuizAttempt {
  id           String   @id @default(uuid())
  userId       String
  quizId       String
  scorePercent Int
  passed       Boolean  @default(false)
  answers      Json     // user submitted answers { questionId: selectedOptionId }
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

model ModuleInteraction {
  id          String                 @id @default(uuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        InteractionType
  promptText  String                 @db.Text
  options     Json?                  // [{ id: "opt1", text: "Label", description?: string }]
  createdAt   DateTime               @default(now())
  userAnswers UserModuleInteraction[]
}

model UserModuleInteraction {
  id               String            @id @default(uuid())
  userId           String
  interactionId    String
  selectedOptionId String?
  textResponse     String?           @db.Text
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interaction      ModuleInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@unique([userId, interactionId])
}

model UserCompanyProgress {
  userId         String
  companyId      String
  completed      Boolean  @default(false)
  lastAccessedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([userId])
}

model Badge {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  description  String      @db.Text
  criteriaJson Json
  userBadges   UserBadge[]
}

model UserBadge {
  userId  String
  badgeId String
  earnedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge   Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model UserStreak {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreakDays Int      @default(0)
  longestStreakDays Int      @default(0)
  lastActivityDate  DateTime @default(now())
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  verificationId String   @unique @default(uuid())
  learnerName    String
  completionDate DateTime @default(now())
  programName    String   @default("AI Company Case Library Learning Experience")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Insight {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  authorName     String
  publishedDate  DateTime  @default(now())
  readingTimeMin Int       @default(5)
  contentMd      String    @db.Text
  tagsJson       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
